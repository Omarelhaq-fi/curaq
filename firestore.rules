// =============================================================================
// OmNote — Firestore Security Rules (hardened)
// Apply in Firebase Console: Firestore → Rules → Publish
//
// Threat model
//   • Client SDK is fully untrusted. Anything sensitive (API keys, admin config,
//     quotas, payment secrets, patch notes, prompts, other users' data) is
//     locked to server-only access via the service account, which bypasses
//     these rules.
//   • Signed-in users can only read/write their OWN /users/{uid} tree and
//     their OWN /users_index/{uid} mirror row (limited fields).
//   • Nothing is world-readable. No collection is writable while signed-out.
//   • Default: DENY. Any path not explicitly matched is blocked.
// =============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----- helpers ----------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Prevent DoS via huge documents. Firestore max is 1 MiB; we cap at
    // 900 KB to leave headroom for indexes and metadata.
    function underSizeLimit() {
      return request.resource == null
        || request.resource.size() < 900 * 1024;
    }

    // Only allow fields we expect on /users_index. Blocks a hostile client
    // from injecting arbitrary fields onto their public directory row.
    // For creates, check all keys.
    function isValidIndexCreate(uid) {
      return request.resource.data.keys().hasOnly(['email', 'lastSeen', 'docCount', 'flashcardCount', 'country', 'displayName', 'qbankGrants'])
        // email, if present, must match the caller's verified auth email
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email)
        // lastSeen, if present, must be the server timestamp (no back-dating)
        && (!('lastSeen' in request.resource.data) || request.resource.data.lastSeen == request.time)
        && (!('docCount' in request.resource.data) || (request.resource.data.docCount is number && request.resource.data.docCount >= 0 && request.resource.data.docCount < 100000))
        && (!('flashcardCount' in request.resource.data) || (request.resource.data.flashcardCount is number && request.resource.data.flashcardCount >= 0 && request.resource.data.flashcardCount < 100000))
        // country: one of the supported values, set once by the welcome screen
        && (!('country' in request.resource.data) || (request.resource.data.country is string && request.resource.data.country in ['egypt', 'tunisia', 'algeria', 'morocco', 'global']))
        // displayName: short string
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 60))
        // qbankGrants: users may only create it EMPTY — grants are added by
        // the admin via the server (service account bypasses these rules).
        && (!('qbankGrants' in request.resource.data) || (request.resource.data.qbankGrants is list && request.resource.data.qbankGrants.size() == 0));
    }

    // For updates, use diff to ensure they don't overwrite server-injected fields
    // and only touch the allowed fields.
    function isValidIndexUpdate(uid) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'lastSeen', 'docCount', 'flashcardCount', 'country', 'displayName', 'qbankGrants'])
        && (!('email' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.email == request.auth.token.email)
        && (!('lastSeen' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.lastSeen == request.time)
        && (!('docCount' in request.resource.data.diff(resource.data).affectedKeys()) || (request.resource.data.docCount is number && request.resource.data.docCount >= 0 && request.resource.data.docCount < 100000))
        && (!('flashcardCount' in request.resource.data.diff(resource.data).affectedKeys()) || (request.resource.data.flashcardCount is number && request.resource.data.flashcardCount >= 0 && request.resource.data.flashcardCount < 100000))
        // country: supported values only; immutable once set (prevents switching later)
        && (!('country' in request.resource.data.diff(resource.data).affectedKeys())
             || (request.resource.data.country is string
                 && request.resource.data.country in ['egypt', 'tunisia', 'algeria', 'morocco', 'global']
                 && (!('country' in resource.data) || resource.data.country == null || resource.data.country == '')))
        && (!('displayName' in request.resource.data.diff(resource.data).affectedKeys())
             || (request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 60))
        // qbankGrants: may never be modified by clients after creation
        // (empty-on-create only; admin grants go through the server)
        && (!('qbankGrants' in request.resource.data.diff(resource.data).affectedKeys())
             || (request.resource.data.qbankGrants is list
                 && (!('qbankGrants' in resource.data) || resource.data.qbankGrants.size() == 0)
                 && request.resource.data.qbankGrants.size() == 0));
    }

    // ----- admin / config / secrets ----------------------------------------
    // API keys, prompts, quota_config, maintenance flags, payment settings,
    // patch notes drafts, admin email list, etc. All writes and reads must go
    // through the server (/api/admin/*) which uses the Admin SDK.
    match /admin/{doc=**} {
      allow read, write: if false;
    }

    // ----- per-user private data -------------------------------------------
    // Everything under /users/{uid} is owner-only. Documents, flashcards,
    // quizzes, summaries, mind maps, whiteboards, scheduler, pomodoro stats,
    // credit ledger snapshots, subscription mirror, etc.
    match /users/{uid}/{document=**} {
      allow read:   if isOwner(uid);
      allow write:  if isOwner(uid) && underSizeLimit();
    }

    // ----- public directory mirror -----------------------------------------
    // Minimal row so the server can enumerate users from the admin panel.
    // Owners can read/write only their own row and only the allowed fields.
    // No listing across the collection from the client.
    match /users_index/{uid} {
      allow get:    if isOwner(uid);
      allow list:   if false;

      allow create: if isOwner(uid)
                    && isValidIndexCreate(uid)
                    && underSizeLimit();

      allow update: if isOwner(uid)
                    && isValidIndexUpdate(uid)
                    && underSizeLimit();

      allow delete: if false;
    }

    // ----- study parties (Book Mode: Study Together) -----------------------
    // Party code (6 chars, ~1B combinations) is the invite secret.
    // Any signed-in user with the code can read the party doc + members.
    // Only the host can update party-level fields; only owner can write
    // their own member doc.
    match /studyParties/{code} {
      allow get:    if isSignedIn();
      allow list:   if false;
      allow create: if isSignedIn()
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.status == 'waiting'
                    && underSizeLimit();
      allow update: if isSignedIn()
                    && resource.data.hostUid == request.auth.uid
                    && request.resource.data.hostUid == resource.data.hostUid
                    && underSizeLimit();
      allow delete: if isSignedIn()
                    && resource.data.hostUid == request.auth.uid;

      match /members/{uid} {
        allow read:          if isSignedIn();
        allow create, update: if isOwner(uid) && underSizeLimit();
        allow delete:        if isOwner(uid)
                             || (isSignedIn()
                                 && get(/databases/$(database)/documents/studyParties/$(code)).data.hostUid == request.auth.uid);
      }
    }

    // ----- answer parties (QBank Mode: Party Mode) -------------------------
    match /answerParties/{code} {
      allow get:    if isSignedIn();
      allow list:   if false;
      allow create: if isSignedIn()
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.status == 'waiting'
                    && underSizeLimit();
      allow update: if isSignedIn()
                    // Allow the host to update the party status/currentQuestion
                    && ((resource.data.hostUid == request.auth.uid && request.resource.data.hostUid == resource.data.hostUid)
                        // Or allow players to update status to "revealing" when all locked
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'revealing'))
                    && underSizeLimit();
      allow delete: if isSignedIn()
                    && resource.data.hostUid == request.auth.uid;

      match /members/{uid} {
        allow read:          if isSignedIn();
        allow create:        if isOwner(uid) && underSizeLimit();
        allow update:        if (isOwner(uid) || (isSignedIn() && get(/databases/$(database)/documents/answerParties/$(code)).data.hostUid == request.auth.uid)) && underSizeLimit();
        allow delete:        if isOwner(uid)
                             || (isSignedIn()
                                 && get(/databases/$(database)/documents/answerParties/$(code)).data.hostUid == request.auth.uid);
      }
      
      match /chat/{msgId} {
        allow read:   if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.uid == request.auth.uid
                      && underSizeLimit();
        allow update, delete: if false;
      }
    }

    // ----- peer answer statistics (global) ---------------------------------
    // Aggregated answer counts per question. Any signed-in user can increment
    // counts when they answer. Read is public for signed-in users.
    // Uses unique user tracking to prevent duplicate counting.
    match /questionStats/{questionId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.total == 1
                    && underSizeLimit();
      allow update: if isSignedIn()
                    // Allow updating userCounts, users, total, updatedAt
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userCounts', 'users', 'total', 'updatedAt'])
                    && request.resource.data.total == resource.data.total + 1
                    && underSizeLimit();
      allow delete: if false;
    }

    // ----- default deny ----------------------------------------------------
    // Anything not matched above is blocked. The server bypasses these
    // rules with the service account, so server code is unaffected.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
